# Dockerfile.prod
# Production multi-stage Dockerfile for ZKProofport landing page
# Uses node:20-slim for Next.js and Ubuntu 24.04 for ZK tooling (bb needs glibc >= 2.38)
# bb + required glibc libs are copied from Ubuntu stage to keep final image lightweight

# Stage 1: Install dependencies
FROM node:20-slim AS deps

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

# Stage 2: Build Next.js application
FROM node:20-slim AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy config and source files
COPY package.json package-lock.json* tsconfig.json next.config.ts postcss.config.mjs ./
COPY content ./content
COPY src ./src

# Copy public assets
RUN mkdir -p public && (cp -r public/* ./public/ 2>/dev/null || true)

# Build Next.js app
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npm run build

# Stage 3: Download ZK tooling binaries (nargo + bb)
# Ubuntu 24.04 provides glibc 2.39 which bb requires (>= 2.38)
FROM ubuntu:24.04 AS zk-tools

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates jq && \
    rm -rf /var/lib/apt/lists/*

# Download nargo 1.0.0-beta.8 (Noir compiler)
RUN curl -L https://github.com/noir-lang/noir/releases/download/v1.0.0-beta.8/nargo-x86_64-unknown-linux-gnu.tar.gz \
    | tar xz -C /usr/local/bin && \
    chmod +x /usr/local/bin/nargo

# Download bb v1.0.0-nightly.20250723 (Barretenberg backend)
RUN curl -L "https://github.com/AztecProtocol/aztec-packages/releases/download/v1.0.0-nightly.20250723/barretenberg-amd64-linux.tar.gz" \
    | tar xz -C /usr/local/bin && \
    chmod +x /usr/local/bin/bb

# Collect glibc 2.39 shared libraries that bb needs (not available in Debian Bookworm)
RUN mkdir -p /bb-libs && \
    cp /lib/x86_64-linux-gnu/libc.so.6 /bb-libs/ && \
    cp /lib/x86_64-linux-gnu/libm.so.6 /bb-libs/ && \
    cp /lib/x86_64-linux-gnu/libpthread.so.0 /bb-libs/ 2>/dev/null || true && \
    cp /lib/x86_64-linux-gnu/libdl.so.2 /bb-libs/ 2>/dev/null || true && \
    cp /lib/x86_64-linux-gnu/libstdc++.so.6 /bb-libs/ && \
    cp /lib/x86_64-linux-gnu/libgcc_s.so.1 /bb-libs/ && \
    cp /lib64/ld-linux-x86-64.so.2 /bb-libs/

# Stage 4: Production runtime (lightweight node:20-slim)
FROM node:20-slim

# Install dumb-init for proper signal handling
RUN apt-get update && \
    apt-get install -y --no-install-recommends dumb-init jq && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy ZK tooling binaries from zk-tools stage
COPY --from=zk-tools /usr/local/bin/nargo /usr/local/bin/nargo
COPY --from=zk-tools /usr/local/bin/bb /usr/local/bin/bb.real

# Copy Ubuntu 24.04 glibc libs for bb (glibc 2.39 > Bookworm's 2.36)
COPY --from=zk-tools /bb-libs/ /usr/local/lib/bb-libs/

# Wrapper script: run bb with Ubuntu glibc via ld-linux dynamic linker
RUN printf '#!/bin/sh\nexec /usr/local/lib/bb-libs/ld-linux-x86-64.so.2 --library-path /usr/local/lib/bb-libs /usr/local/bin/bb.real "$@"\n' > /usr/local/bin/bb && \
    chmod +x /usr/local/bin/bb

# Copy Next.js standalone build output
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public/

# Copy content directory (needed for knowledge base)
COPY --from=builder /app/content ./content

EXPOSE 3100

ENV PORT=3100
ENV HOSTNAME="0.0.0.0"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
